<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_voucher_management">
        <field name="name">Recharge Voucher Management</field>
        <field name="description">Access rights for Recharge Voucher Management System</field>
        <field name="sequence">30</field>
    </record>

    <!-- 1. Cashier -->
    <record id="group_voucher_cashier" model="res.groups">
        <field name="name">Cashier</field>
        <field name="category_id" ref="module_category_voucher_management"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <!-- 2. Store Manager -->
    <record id="group_voucher_store_manager" model="res.groups">
        <field name="name">Store Manager</field>
        <field name="category_id" ref="module_category_voucher_management"/>
        <field name="implied_ids" eval="[(4, ref('group_voucher_cashier')), (4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>

    <!-- 3. Finance -->
    <record id="group_voucher_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="category_id" ref="module_category_voucher_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- 4. Auditor -->
    <record id="group_voucher_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="category_id" ref="module_category_voucher_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- 5. Head Office Operations (Admin) -->
    <record id="group_voucher_operations" model="res.groups">
        <field name="name">Head Office Operations</field>
        <field name="category_id" ref="module_category_voucher_management"/>
        <field name="implied_ids" eval="[(4, ref('group_voucher_store_manager')), (4, ref('group_voucher_finance'))]"/>
    </record>

    <!-- Auto-grant Head Office Operations to System Administrators -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_voucher_operations'))]"/>
    </record>

    <!-- Auto-grant Cashier to POS Users so all POS cashiers can sell vouchers -->
    <record id="point_of_sale.group_pos_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_voucher_cashier'))]"/>
    </record>
</odoo>

