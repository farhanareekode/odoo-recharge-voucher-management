<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_form_inherit_voucher" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.voucher</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_vouchers" type="object" class="oe_stat_button" icon="fa-ticket" invisible="voucher_count == 0">
                    <field name="voucher_count" widget="statinfo" string="Vouchers Issued"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Issued Recharge Vouchers" name="vouchers" invisible="voucher_count == 0">
                    <field name="voucher_issue_ids" readonly="1">
                        <tree>
                            <field name="name"/>
                            <field name="service_code"/>
                            <field name="serial_number"/>
                            <field name="face_value" widget="monetary"/>
                            <field name="issue_date"/>
                            <field name="state" widget="badge"/>
                            <field name="currency_id" column_invisible="True"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

