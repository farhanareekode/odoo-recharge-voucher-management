<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_recharge_voucher_tree" model="ir.ui.view">
        <field name="name">recharge.voucher.tree</field>
        <field name="model">recharge.voucher</field>
        <field name="arch" type="xml">
            <tree string="Recharge Vouchers" decoration-danger="state in ('blocked', 'expired')" decoration-warning="state == 'reserved'" decoration-success="state == 'available'" decoration-info="state == 'sold'">
                <header>
                    <button name="%(action_recharge_voucher_import_wizard)d" string="Import Vouchers (CSV)" type="action" class="btn-primary" groups="recharge_voucher_management.group_voucher_operations"/>
                </header>
                <field name="service_code"/>
                <field name="product_tmpl_name"/>
                <field name="serial_number"/>
                <field name="masked_pin"/>
                <field name="face_value" widget="monetary"/>
                <field name="purchase_cost" widget="monetary" groups="recharge_voucher_management.group_voucher_finance,recharge_voucher_management.group_voucher_operations"/>
                <field name="batch_id"/>
                <field name="supplier_id"/>
                <field name="expiry_date"/>
                <field name="store_id" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge" decoration-success="state == 'available'" decoration-warning="state == 'reserved'" decoration-info="state == 'sold'" decoration-danger="state in ('blocked', 'expired')"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_recharge_voucher_form" model="ir.ui.view">
        <field name="name">recharge.voucher.form</field>
        <field name="model">recharge.voucher</field>
        <field name="arch" type="xml">
            <form string="Recharge Voucher">
                <header>
                    <button name="action_block" string="Block Voucher" type="object" class="btn-danger" invisible="state in ('sold', 'blocked')" groups="recharge_voucher_management.group_voucher_operations,recharge_voucher_management.group_voucher_store_manager"/>
                    <button name="action_unblock" string="Unblock Voucher" type="object" class="btn-warning" invisible="state != 'blocked'" groups="recharge_voucher_management.group_voucher_operations"/>
                    <field name="state" widget="statusbar" statusbar_visible="available,reserved,sold,blocked,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="serial_number" string="Voucher Serial Number"/>
                        <h1>
                            <field name="serial_number" readonly="state != 'available'"/>
                        </h1>
                        <h3>
                            <field name="service_code" readonly="state != 'available'"/> - <field name="product_tmpl_name" readonly="1"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Denomination &amp; Pricing">
                            <field name="face_value" widget="monetary" readonly="state != 'available'"/>
                            <field name="purchase_cost" widget="monetary" readonly="state != 'available'" groups="recharge_voucher_management.group_voucher_finance,recharge_voucher_management.group_voucher_operations"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Supplier &amp; Expiry">
                            <field name="batch_id" readonly="state != 'available'"/>
                            <field name="supplier_id" readonly="1"/>
                            <field name="expiry_date" readonly="state != 'available'"/>
                        </group>
                    </group>
                    <group string="PIN Security &amp; Masking">
                        <group>
                            <field name="masked_pin" readonly="1"/>
                        </group>
                        <group>
                            <field name="pin_fingerprint" readonly="1" groups="recharge_voucher_management.group_voucher_operations,recharge_voucher_management.group_voucher_auditor"/>
                        </group>
                    </group>
                    <group string="Store Reservation &amp; Issuance" invisible="state == 'available'">
                        <group>
                            <field name="store_id" readonly="1"/>
                            <field name="reservation_token" readonly="1" invisible="not reservation_token"/>
                            <field name="reservation_time" readonly="1" invisible="not reservation_time"/>
                        </group>
                        <group>
                            <field name="pos_order_id" readonly="1" invisible="not pos_order_id"/>
                            <field name="issued_date" readonly="1" invisible="not issued_date"/>
                            <field name="issue_id" readonly="1" invisible="not issue_id"/>
                            <field name="block_reason" readonly="1" invisible="not block_reason"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_recharge_voucher_pivot" model="ir.ui.view">
        <field name="name">recharge.voucher.pivot</field>
        <field name="model">recharge.voucher</field>
        <field name="arch" type="xml">
            <pivot string="Voucher Inventory Matrix" sample="1">
                <field name="service_code" type="row"/>
                <field name="state" type="col"/>
                <field name="face_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_recharge_voucher_graph" model="ir.ui.view">
        <field name="name">recharge.voucher.graph</field>
        <field name="model">recharge.voucher</field>
        <field name="arch" type="xml">
            <graph string="Voucher Status Breakdown" type="bar">
                <field name="service_code"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_recharge_voucher_search" model="ir.ui.view">
        <field name="name">recharge.voucher.search</field>
        <field name="model">recharge.voucher</field>
        <field name="arch" type="xml">
            <search string="Search Vouchers">
                <field name="serial_number"/>
                <field name="service_code"/>
                <field name="batch_id"/>
                <field name="supplier_id"/>
                <field name="store_id"/>
                <field name="pos_order_id"/>
                <separator/>
                <filter string="Available Stock" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Reserved" name="reserved" domain="[('state', '=', 'reserved')]"/>
                <filter string="Sold" name="sold" domain="[('state', '=', 'sold')]"/>
                <filter string="Blocked" name="blocked" domain="[('state', '=', 'blocked')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                <group expand="0" string="Group By">
                    <filter string="Service Code" name="group_service_code" context="{'group_by': 'service_code'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Batch Reference" name="group_batch" context="{'group_by': 'batch_id'}"/>
                    <filter string="Supplier" name="group_supplier" context="{'group_by': 'supplier_id'}"/>
                    <filter string="Store / Terminal" name="group_store" context="{'group_by': 'store_id'}"/>
                    <filter string="Expiry Date" name="group_expiry" context="{'group_by': 'expiry_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_recharge_voucher_all" model="ir.actions.act_window">
        <field name="name">All Vouchers</field>
        <field name="res_model">recharge.voucher</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="context">{'search_default_group_service_code': 1}</field>
    </record>

    <record id="action_recharge_voucher_available" model="ir.actions.act_window">
        <field name="name">Available Vouchers</field>
        <field name="res_model">recharge.voucher</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="domain">[('state', '=', 'available')]</field>
    </record>

    <record id="action_recharge_voucher_sold" model="ir.actions.act_window">
        <field name="name">Sold Vouchers</field>
        <field name="res_model">recharge.voucher</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="domain">[('state', '=', 'sold')]</field>
    </record>
</odoo>

