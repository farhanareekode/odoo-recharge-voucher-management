<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_recharge_voucher_supplier_tree" model="ir.ui.view">
        <field name="name">recharge.voucher.supplier.tree</field>
        <field name="model">recharge.voucher.supplier</field>
        <field name="arch" type="xml">
            <tree string="Voucher Suppliers">
                <field name="code"/>
                <field name="name"/>
                <field name="contact_name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="batch_count"/>
                <field name="voucher_count"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_recharge_voucher_supplier_form" model="ir.ui.view">
        <field name="name">recharge.voucher.supplier.form</field>
        <field name="model">recharge.voucher.supplier</field>
        <field name="arch" type="xml">
            <form string="Voucher Supplier">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_batches" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="batch_count" widget="statinfo" string="Batches"/>
                        </button>
                        <button name="action_view_vouchers" type="object" class="oe_stat_button" icon="fa-ticket">
                            <field name="voucher_count" widget="statinfo" string="Vouchers"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Supplier Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. National Telecom Distributors"/>
                        </h1>
                        <h3>
                            <field name="code" placeholder="Supplier Code (e.g. NTDD)"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Contact Info">
                            <field name="contact_name"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="active"/>
                        </group>
                        <group string="Address">
                            <field name="address"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Batches" name="batches">
                            <field name="batch_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="date_received"/>
                                    <field name="total_vouchers"/>
                                    <field name="available_count"/>
                                    <field name="sold_count"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_recharge_voucher_supplier" model="ir.actions.act_window">
        <field name="name">Voucher Suppliers</field>
        <field name="res_model">recharge.voucher.supplier</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>

