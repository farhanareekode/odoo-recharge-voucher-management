<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_recharge_voucher_product_tree" model="ir.ui.view">
        <field name="name">recharge.voucher.product.tree</field>
        <field name="model">recharge.voucher.product</field>
        <field name="arch" type="xml">
            <tree string="Voucher Products">
                <field name="service_code"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="face_value" widget="monetary"/>
                <field name="selling_price" widget="monetary"/>
                <field name="available_count" decoration-danger="available_count &lt; 5" decoration-warning="available_count &lt; 10" decoration-success="available_count &gt;= 10"/>
                <field name="reserved_count"/>
                <field name="sold_count"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_recharge_voucher_product_form" model="ir.ui.view">
        <field name="name">recharge.voucher.product.form</field>
        <field name="model">recharge.voucher.product</field>
        <field name="arch" type="xml">
            <form string="Voucher Product">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_available_vouchers" type="object" class="oe_stat_button" icon="fa-check-circle">
                            <field name="available_count" widget="statinfo" string="Available"/>
                        </button>
                        <button name="action_view_vouchers" type="object" class="oe_stat_button" icon="fa-ticket">
                            <field name="voucher_count" widget="statinfo" string="Total Vouchers"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Voucher Product Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Airtel Recharge ₹100"/>
                        </h1>
                        <h3>
                            <field name="service_code" placeholder="Service Code (e.g. AIR-100)"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Commercial Pricing">
                            <field name="face_value" widget="monetary"/>
                            <field name="selling_price" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="min_stock_alert"/>
                            <field name="active"/>
                        </group>
                        <group string="POS Linkage">
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Inventory Overview">
                        <group>
                            <field name="available_count"/>
                            <field name="reserved_count"/>
                        </group>
                        <group>
                            <field name="sold_count"/>
                            <field name="voucher_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Terms &amp; Notes" name="terms">
                            <field name="notes" placeholder="Enter terms of use or supplier details..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_recharge_voucher_product_search" model="ir.ui.view">
        <field name="name">recharge.voucher.product.search</field>
        <field name="model">recharge.voucher.product</field>
        <field name="arch" type="xml">
            <search string="Search Voucher Products">
                <field name="name"/>
                <field name="service_code"/>
                <field name="product_id"/>
                <filter string="Low Stock (&lt; 10)" name="low_stock" domain="[('available_count', '&lt;', 10)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_recharge_voucher_product" model="ir.actions.act_window">
        <field name="name">Voucher Products</field>
        <field name="res_model">recharge.voucher.product</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Voucher Product denomination!
            </p>
        </field>
    </record>
</odoo>

