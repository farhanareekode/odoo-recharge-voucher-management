<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_cleanup_stale_reservations" model="ir.cron">
        <field name="name">Recharge Vouchers: Release Stale Reservations</field>
        <field name="model_id" ref="model_recharge_voucher"/>
        <field name="state">code</field>
        <field name="code">model.cron_cleanup_expired_reservations()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_mark_expired_vouchers" model="ir.cron">
        <field name="name">Recharge Vouchers: Mark Expired Inventory</field>
        <field name="model_id" ref="model_recharge_voucher"/>
        <field name="state">code</field>
        <field name="code">model.cron_mark_expired_vouchers()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>

